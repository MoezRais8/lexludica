---
// Champ d'inscription à la newsletter, relié au formulaire Brevo « Inscription site »
// (liste Newsletter Lex Ludica, double opt-in). Pour changer de formulaire, remplacer BREVO_ACTION.
interface Props { id: string; surBleu?: boolean }
const { id, surBleu = false } = Astro.props;
---
<form class:list={['form-nl', { 'sur-bleu': surBleu }]} data-nl novalidate>
  <div class="ligne">
    <label class="champ" for={id}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
      <span class="sr">Adresse e-mail</span>
      <input id={id} name="email" type="email" autocomplete="email" placeholder="Adresse email…" required />
    </label>
    <button type="submit" class:list={['bouton', { blanc: surBleu }]}>M'abonner</button>
  </div>
  <p class="note" aria-live="polite">En vous inscrivant, vous acceptez notre <a href="/confidentialite">politique de confidentialité</a>.</p>
</form>

<script>
  const BREVO_ACTION = 'https://9576b5de.sibforms.com/serve/MUIFACQwY2wsAYnmvSZGV0NDVBu7DQFLj9ATysImpgpLODn1m32_dae2hnJb34sURs8YJJor0RH6TuCfVUlVnuM1Q3X51BvCW7JIrRUtmxfG7FQQWN4hlqXnaZHWH4A89pM333p9RqzExHxbbv2WoVZnbctcbRPFzImOFYrBdZkCtmrvM4VmLwdIRc9YUKNq6xo_RWKm6M8SR-uoJA==';

  document.querySelectorAll<HTMLFormElement>('form[data-nl]').forEach((form) => {
    const input = form.querySelector('input') as HTMLInputElement;
    const bouton = form.querySelector('button') as HTMLButtonElement;
    const note = form.querySelector('.note') as HTMLElement;
    const noteInitiale = note.innerHTML;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      note.classList.remove('ok', 'ko');
      if (!email) {
        note.classList.add('ko');
        note.textContent = "Merci d'indiquer votre adresse e-mail.";
        input.focus();
        return;
      }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        note.classList.add('ko');
        note.textContent = 'Cette adresse e-mail ne semble pas valide. Vérifiez-la et réessayez.';
        input.focus();
        return;
      }
      bouton.disabled = true;
      note.textContent = 'Inscription en cours…';
      try {
        const donnees = new URLSearchParams({ EMAIL: email, email_address_check: '', locale: 'fr', html_type: 'simple' });
        // Envoi direct au formulaire Brevo ; la réponse n'est pas lisible depuis le site (mode no-cors)
        await fetch(BREVO_ACTION, { method: 'POST', mode: 'no-cors', body: donnees });
        form.reset();
        note.classList.add('ok');
        note.textContent = "C'est fait ! Vous êtes inscrit à la newsletter de Lex Ludica. Un e-mail de bienvenue vient de vous être envoyé.";
      } catch {
        note.classList.add('ko');
        note.textContent = "Oups, l'inscription n'a pas pu aboutir. Merci de réessayer dans quelques instants.";
        setTimeout(() => { note.classList.remove('ko'); note.innerHTML = noteInitiale; }, 8000);
      } finally {
        bouton.disabled = false;
      }
    });
  });
</script>

<style>
  .form-nl { width: 100%; max-width: 24rem; }
  .ligne { display: flex; gap: 0.5rem; }
  .champ {
    flex: 1; min-width: 0; display: flex; align-items: center; gap: 0.5rem;
    background: #e7e8e7; color: var(--muted); border-radius: 3px; padding: 0 0.7rem;
  }
  .champ svg { width: 1rem; height: 1rem; flex: none; }
  input { flex: 1; min-width: 0; border: 0; background: transparent; font: inherit; font-size: 0.82rem; padding: 0.6rem 0; color: var(--ink); outline: none; }
  .champ:focus-within { outline: 2px solid var(--blue); outline-offset: 2px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .note { font-size: 0.68rem; color: var(--muted); margin: 0.5rem 0 0; }
  .note a { color: inherit; }
  .note.ok, .note.ko { font-size: 0.85rem; font-weight: 600; line-height: 1.45; padding: 0.55rem 0.7rem; border-radius: 3px; margin-top: 0.7rem; }
  .note.ok { background: #e3f3e8; color: #1d6b3a; }
  .note.ko { background: #fdeaea; color: #9b2121; }
  .sur-bleu .champ { background: rgba(255, 255, 255, 0.14); color: rgba(255, 255, 255, 0.75); }
  .sur-bleu input { color: #ffffff; }
  .sur-bleu input::placeholder { color: rgba(255, 255, 255, 0.7); }
  .sur-bleu .champ:focus-within { outline-color: #ffffff; }
  .sur-bleu .note { color: rgba(255, 255, 255, 0.72); }
  .sur-bleu .note.ok, .sur-bleu .note.ko { background: rgba(255, 255, 255, 0.12); color: #ffffff; border-left: 3px solid var(--yellow); }
  .sur-bleu .note.ko { border-left-color: #ff9b9b; }
</style>
