---
import Base from '../../layouts/Base.astro';
import TitrePage from '../../components/TitrePage.astro';
import CarteArticle from '../../components/CarteArticle.astro';
import { rubriques } from '../../data/rubriques';
import { articlesPublies } from '../../lib/utils';
const articles = await articlesPublies();
---
<Base titre="Tous les articles" description="Toutes les analyses publiées par Lex Ludica.">
  <TitrePage titre="Tous les" accent="articles" sous={`${articles.length} analyses publiées, de la plus récente à la plus ancienne.`}>
    <nav class="filtres" aria-label="Catégories">
      {rubriques.map((r) => <a class="tag sombre tag-rub" style={`--rub:${r.couleur}`} href={`/rubriques/${r.slug}`}>{r.nom}</a>)}
      <a class="tag cal-lien" href="/calendrier">Parcourir par date</a>
    </nav>
  </TitrePage>
  <section class="bande">
    <div class="cadre bloc">
      <div class="grille">{articles.map((a) => <CarteArticle article={a} />)}</div>
    </div>
  </section>
</Base>

<style>
  .filtres { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.4rem; }
  .bloc { padding-block: 2.6rem 3rem; }
  .cal-lien { background: var(--yellow); color: var(--on-yellow); }
  .grille { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 2rem 1.4rem; }
</style>
