---
import Base from '../layouts/Base.astro';
import CarteArticle from '../components/CarteArticle.astro';
import Visuel from '../components/Visuel.astro';
import Pixels from '../components/Pixels.astro';
import BandeNewsletter from '../components/BandeNewsletter.astro';
import { getRubrique, accueilGauche, accueilDroite } from '../data/rubriques';
import { articlesPublies, formatDateCourte, slugTag } from '../lib/utils';
import { getCollection } from 'astro:content';
import { sections } from '../data/site';

const articles = await articlesPublies();
const tendance = articles.find((a) => a.data.une) ?? articles[0];
// « Populaire » : les articles classés à la main, sinon les plus récents après celui en tendance
const classes = articles
  .filter((a) => a.data.populaire && a.id !== tendance?.id)
  .sort((a, b) => (a.data.populaire ?? 9) - (b.data.populaire ?? 9));
const populaires = (classes.length ? classes : articles.filter((a) => a.id !== tendance?.id)).slice(0, 3);
const recents = articles.filter((a) => a.id !== tendance?.id && !populaires.includes(a)).slice(0, 6);
const rubTendance = tendance && getRubrique(tendance.data.rubrique);
const colonnes = [accueilGauche, accueilDroite].map((c) => c.map(getRubrique));
const breves = sections.breves ? (await getCollection('breves')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4) : [];
const dossier = sections.dossiers ? (await getCollection('dossiers')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0] : undefined;
---
<Base>
  <section class="bande hero" aria-labelledby="hero-titre">
    <div class="cadre hero-cadre">
      <div class="hero-texte">
        <h1 id="hero-titre">Au-delà du <em class="accent">jeu vidéo</em></h1>
        <p class="hero-sous">Lex Ludica analyse le jeu vidéo au croisement du droit, de la culture, de l'économie et des sciences humaines.</p>
      </div>
      <nav class="hero-liens" aria-label="Raccourcis">
        <a href="/articles">Nos articles</a>
        <a href="/a-propos">Notre histoire</a>
        <a href="/contact">Contact</a>
      </nav>
      <Pixels motif="hero" class="hero-pixels" />
    </div>
  </section>

  {tendance && rubTendance && (
  <section class="bande">
    <div class:list={['cadre une', { seule: populaires.length === 0 }]}>
      <div class="tendance">
        <div class="tete-section"><h2>{populaires.length ? 'En tendance' : 'À la une'}</h2></div>
        <a class="lien-visuel" href={`/articles/${tendance.id}`} tabindex="-1" aria-hidden="true">
          <Visuel slug={tendance.id} rubrique={tendance.data.rubrique} image={tendance.data.image} alt={tendance.data.imageAlt ?? ''} ratio="16 / 9" grand />
        </a>
        <p class="infos">
          <a class="tag sombre" href={`/rubriques/${rubTendance.slug}`}>#{rubTendance.nom.toLowerCase()}</a>
          <span class="date">{formatDateCourte(tendance.data.date)}</span>
        </p>
        <h3 class="titre-tendance"><a href={`/articles/${tendance.id}`}>{tendance.data.titre}</a></h3>
        {populaires.length === 0 && <p class="chapo-une">{tendance.data.chapo}</p>}
        {populaires.length === 0 && <a class="bouton" href={`/articles/${tendance.id}`}>Lire l'article</a>}
      </div>
      {populaires.length > 0 && (
      <aside class="populaire" aria-labelledby="pop-titre">
        <div class="tete-section"><h2 id="pop-titre">Populaire</h2></div>
        <ol>
          {populaires.map((a, i) => {
            const r = getRubrique(a.data.rubrique);
            return (
              <li>
                <span class="rang" aria-hidden="true">{i + 1}</span>
                <p class="infos">
                  <a class="tag" href={`/rubriques/${r.slug}`}>#{r.nom.toLowerCase()}</a>
                  <span class="date">{formatDateCourte(a.data.date)}</span>
                </p>
                <a class="titre-pop" href={`/articles/${a.id}`}>{a.data.titre}</a>
              </li>
            );
          })}
        </ol>
      </aside>
      )}
    </div>
  </section>
  )}

  <BandeNewsletter />

  <section class="bande" aria-labelledby="cat-titre">
    <div class="cadre bloc">
      <div class="tete-section">
        <h2 id="cat-titre">Catégories</h2>
        <a class="lien-plus" href="/rubriques">Toutes les catégories</a>
      </div>
      <div class="categories">
        {colonnes.map((col, ci) => (
          <div class:list={['col-cat', ci === 0 ? 'large' : 'etroite']}>
            {col.map((r) => (
              <article class="cat">
                <h3><a href={`/rubriques/${r.slug}`} class="accent">{r.nom}</a></h3>
                <p>{r.description}</p>
                <div class="cat-tags">{r.tags.map((t) => <a class="tag" href={`/etiquettes/${slugTag(t)}`}>#{t}</a>)}</div>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  {recents.length > 0 && (
  <section class="bande" aria-labelledby="rec-titre">
    <div class="cadre bloc">
      <div class="tete-section">
        <h2 id="rec-titre">Articles récents</h2>
        <a class="lien-plus" href="/articles">Tous nos articles</a>
      </div>
      <div class="grille">{recents.map((a) => <CarteArticle article={a} />)}</div>
    </div>
  </section>
  )}

  {(breves.length > 0 || dossier) && (
  <section class="bande" aria-labelledby="bref-titre">
    <div class="cadre bloc bref">
      {breves.length > 0 && (
      <div class="bref-liste">
        <div class="tete-section">
          <h2 id="bref-titre">En bref</h2>
          <a class="lien-plus" href="/breves">Toutes les brèves</a>
        </div>
        <ul>
          {breves.map((b) => (
            <li>
              <span class="date">{formatDateCourte(b.data.date)}</span>
              <a href={`/breves#${b.id}`}>{b.data.titre}</a>
            </li>
          ))}
        </ul>
      </div>
      )}
      {dossier && (
        <a class="dossier-une" href={`/dossiers/${dossier.id}`}>
          <span class="d-sur">Dossier</span>
          <span class="d-titre">{dossier.data.titre} {dossier.data.accent && <em class="accent">{dossier.data.accent}</em>}</span>
          <span class="d-chapo">{dossier.data.chapo}</span>
          <span class="d-lien">{dossier.data.articles.length} articles à lire dans l'ordre</span>
        </a>
      )}
    </div>
  </section>
  )}

  <section class="bande" aria-labelledby="equipe-titre">
    <div class="cadre bloc">
      <div class="equipe">
        <div class="equipe-texte">
          <h2 id="equipe-titre">Un blog de <em class="accent">passionnés</em></h2>
          <p class="equipe-sous">Pluridisciplinaire, consacré à l'industrie vidéoludique et à la pop-culture.</p>
          <p>Le jeu vidéo est bien plus qu'un divertissement : c'est un miroir de notre société et un défi permanent pour le droit.</p>
          <p>Lex Ludica est un blog dans lequel nous décryptons l'industrie sous divers angles. De la propriété intellectuelle des <em>assets</em> numériques à l'impact sociologique des mondes persistants, nous explorons les zones d'ombre du média le plus influent du XXI<sup>e</sup> siècle.</p>
          <p>Retrouvez des articles de fond, des analyses juridiques, historiques et des réflexions sur le futur numérique de l'industrie vidéoludique.</p>
          <a class="bouton" href="/contributeurs">Découvrir l'équipe</a>
        </div>
        <Pixels motif="equipe" class="equipe-pixels" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { background: radial-gradient(ellipse 50% 90% at 6% 0%, #ece6db 0%, transparent 70%); }
  .hero-cadre { position: relative; min-height: 15rem; display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; padding-block: 3.2rem 1.2rem; overflow: hidden; }
  .hero-texte { position: relative; z-index: 1; max-width: 36rem; }
  h1 { font-size: clamp(2.1rem, 4.6vw, 3.1rem); font-weight: 400; letter-spacing: -0.025em; }
  h1 .accent { font-size: 1.1em; }
  .hero-sous { margin: 1rem 0 0; font-style: italic; color: var(--ink-soft); max-width: 30rem; line-height: 1.5; }
  .hero-liens { position: relative; z-index: 1; display: flex; gap: 1.1rem; align-self: flex-end; margin-right: min(22%, 15rem); }
  .hero-liens a { font-size: 0.75rem; color: var(--muted); text-decoration: none; }
  .hero-liens a:hover { color: var(--blue); }
  .hero-cadre :global(.hero-pixels) { position: absolute; right: 0; top: 0; height: 100%; width: auto; max-width: 40%; }

  /* En tendance + Populaire */
  .une { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 0; padding-block: 0; }
  .tendance { padding: 2.4rem 2.2rem 2.6rem 0; border-right: 1px solid var(--line); }
  .populaire { padding: 2.4rem 0 2.6rem 2.2rem; }
  .lien-visuel { display: block; }
  .infos { display: flex; align-items: center; gap: 0.6rem; margin: 0.9rem 0 0.55rem; }
  .titre-tendance { font-size: clamp(1.3rem, 2.4vw, 1.6rem); font-weight: 500; line-height: 1.3; max-width: 30ch; }
  .titre-tendance a { color: var(--ink); text-decoration: none; }
  .titre-tendance a:hover { color: var(--blue); }
  /* Un seul article : visuel et texte côte à côte */
  .une.seule { grid-template-columns: 1fr; }
  .une.seule .tendance {
    border-right: 0; padding-right: 0;
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: 2.4rem; align-items: start;
  }
  .une.seule .tendance > .tete-section { grid-column: 1 / -1; }
  .une.seule .lien-visuel { grid-row: span 4; }
  .une.seule .infos { margin-top: 0; }
  .chapo-une { margin: 0.9rem 0 1.4rem; color: var(--ink-soft); line-height: 1.6; }
  .une.seule .bouton { justify-self: start; }
  @media (max-width: 900px) {
    .une.seule .tendance { grid-template-columns: 1fr; }
    .une.seule .lien-visuel { grid-row: auto; }
    .une.seule .infos { margin-top: 0.9rem; }
  }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  ol li { position: relative; overflow: hidden; background: var(--card); padding: 0.85rem 1rem 1.1rem; border-radius: 2px; min-height: 7.4rem; }
  ol .infos { margin: 0 0 0.6rem; position: relative; z-index: 1; }
  .rang {
    position: absolute; right: 0.6rem; bottom: -1.6rem;
    font-family: var(--serif); font-style: italic; font-size: 7.5rem; line-height: 1;
    color: transparent; -webkit-text-stroke: 1px #c9cac8;
  }
  .titre-pop { position: relative; z-index: 1; display: block; font-size: 0.86rem; line-height: 1.45; color: var(--ink); text-decoration: none; max-width: 24ch; }
  .titre-pop:hover { color: var(--blue); }

  /* Blocs génériques */
  .bloc { padding-block: 2.6rem 3rem; }

  /* Catégories */
  .categories { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 1rem; align-items: start; }
  .col-cat { display: grid; gap: 1rem; }
  .cat { background: var(--surface); border: 1px solid var(--line); padding: 1.4rem 1.3rem 1.2rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .large .cat { min-height: 11.5rem; }
  .etroite .cat:last-child { min-height: 14.5rem; }
  .cat h3 { font-size: 1.85rem; line-height: 1; }
  .cat h3 a { color: var(--ink); text-decoration: none; }
  .cat h3 a:hover { color: var(--blue); }
  .cat p { margin: 0; font-size: 0.78rem; line-height: 1.55; color: var(--muted); max-width: 46ch; }
  .cat-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 0.6rem; }

  /* Articles récents */
  .grille { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 1.4rem; }

  /* En bref + dossier */
  .bref { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 2.5rem; align-items: start; }
  .bref ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .bref li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
  .bref li a { color: var(--ink); text-decoration: none; }
  .bref li a:hover { color: var(--blue); }
  .dossier-une { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.5rem; background: var(--yellow); color: var(--on-yellow); text-decoration: none; }
  .d-sur { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .d-titre { font-size: 1.5rem; line-height: 1.15; }
  .d-titre .accent { font-size: 1.1em; }
  .d-chapo { font-size: 0.86rem; line-height: 1.5; }
  .d-lien { font-size: 0.8rem; font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; }
  .dossier-une:hover { filter: brightness(0.97); }

  /* Équipe */
  .equipe {
    position: relative; overflow: hidden;
    background: linear-gradient(135deg, #00418a 0%, #0055b4 55%, #1a6fd0 100%);
    color: #ffffff; min-height: 18rem;
    display: flex; align-items: flex-end;
    padding: 2rem;
  }
  .equipe::before {
    content: ''; position: absolute; inset: 0;
    background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 2.5rem 2.5rem;
  }
  .equipe-texte { position: relative; z-index: 1; max-width: 36rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  .equipe h2 { font-size: clamp(1.5rem, 2.8vw, 1.9rem); font-weight: 400; line-height: 1.12; }
  .equipe h2 .accent { font-size: 1.1em; }
  .equipe p { margin: 0; font-size: 0.92rem; line-height: 1.6; color: rgba(255, 255, 255, 0.88); }
  .equipe .equipe-sous { font-size: 1rem; color: #ffffff; font-weight: 500; margin-top: -0.3rem; }
  .equipe-texte .bouton { margin-top: 0.4rem; }
  .equipe :global(.equipe-pixels) { position: absolute; right: 0; bottom: 0; height: 70%; width: auto; max-width: 34%; }

  @media (max-width: 900px) {
    .une { grid-template-columns: 1fr; }
    .tendance { padding-right: 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .populaire { padding-left: 0; }
    .categories { grid-template-columns: 1fr; }
    .grille { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bref { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .hero-cadre { padding-top: 6.5rem; }
    .hero-cadre :global(.hero-pixels) { height: 5.5rem; max-width: none; }
    .hero-liens { align-self: flex-start; margin-right: 0; }
    .grille { grid-template-columns: 1fr; }
    .equipe { padding: 1.4rem; min-height: 20rem; align-items: flex-start; }
    .equipe :global(.equipe-pixels) { display: none; }
  }
</style>
