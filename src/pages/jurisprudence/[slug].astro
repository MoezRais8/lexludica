---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListeOuVide from '../../components/ListeOuVide.astro';
import { articlesPublies, formatDate, refDecision, slugTag } from '../../lib/utils';

export async function getStaticPaths() {
  const decisions = await getCollection('decisions');
  return decisions.map((decision) => ({ params: { slug: decision.id }, props: { decision } }));
}
const { decision } = Astro.props;
const { Content } = await render(decision);
const d = decision.data;
const articles = (await articlesPublies('toutes')).filter((a) => a.data.decisions.some((x) => x.id === decision.id));
const ref = refDecision(decision);
---
<Base section="jurisprudence" titre={`${d.nom} (${d.date.getFullYear()})`} description={d.apport}>
  <section class="bande tete">
    <div class="cadre interieur">
      <p class="fil"><a href="/jurisprudence">Jurisprudence</a> › {d.ordre}</p>
      <h1><em class="accent">{d.nom}</em></h1>
      <p class="ref" id="ref-decision">{ref}</p>
      <p class="apport">{d.apport}</p>
      <dl class="fiche">
        <div><dt>Juridiction</dt><dd>{d.juridiction}</dd></div>
        <div><dt>Date</dt><dd>{formatDate(d.date)}</dd></div>
        <div><dt>Référence</dt><dd>{d.numero}</dd></div>
        {d.parties && <div class="large"><dt>Parties</dt><dd>{d.parties}</dd></div>}
      </dl>
      <div class="themes">{d.themes.map((t) => <a class="tag" href={`/etiquettes/${slugTag(t)}`}>#{t}</a>)}</div>
    </div>
  </section>
  <section class="bande">
    <div class="cadre bloc">
      <div class="resume">
        <h2>Ce qu'il faut <em class="accent">retenir</em></h2>
        <Content />
        <button type="button" class="bouton" data-copier="ref-decision">Copier la référence</button>
      </div>
    </div>
  </section>
  <section class="bande titre-liste">
    <div class="cadre"><h2>Cité dans {articles.length} {articles.length > 1 ? 'articles' : 'article'}</h2></div>
  </section>
  <ListeOuVide articles={articles} messageVide="Aucune analyse ne cite encore cette décision." />
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copier]').forEach((btn) => {
    const libelle = btn.textContent;
    btn.addEventListener('click', async () => {
      const cible = document.getElementById(btn.dataset.copier ?? '');
      if (!cible) return;
      try {
        await navigator.clipboard.writeText(cible.textContent ?? '');
        btn.textContent = 'Référence copiée';
      } catch {
        const r = document.createRange(); r.selectNodeContents(cible);
        const s = window.getSelection(); s?.removeAllRanges(); s?.addRange(r);
        btn.textContent = 'Texte sélectionné, copiez-le';
      }
      setTimeout(() => (btn.textContent = libelle), 2500);
    });
  });
</script>

<style>
  .tete { background: radial-gradient(ellipse 50% 100% at 6% 0%, #ece6db 0%, transparent 70%); }
  .interieur { padding-block: 2.6rem 2.2rem; }
  .fil { margin: 0 0 0.8rem; font-size: 0.78rem; color: var(--muted); }
  .fil a { color: inherit; }
  h1 { font-size: clamp(2.4rem, 5vw, 3.4rem); font-weight: 400; }
  .ref { margin: 0.6rem 0 0; font-weight: 500; color: var(--ink-soft); }
  .apport { font-family: var(--serif); font-style: italic; font-size: 1.45rem; line-height: 1.35; max-width: 40rem; margin: 1rem 0 1.4rem; }
  .fiche { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr)); gap: 0.6rem; margin: 0 0 1.2rem; max-width: 52rem; }
  .fiche div { border-radius: 12px; background: var(--surface); border: 1px solid var(--line); padding: 0.7rem 0.9rem; }
  .fiche .large { grid-column: 1 / -1; }
  dt { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  dd { margin: 0.2rem 0 0; font-size: 0.92rem; }
  .themes { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .bloc { padding-block: 2.4rem 2.6rem; }
  .resume { max-width: var(--lecture); line-height: 1.75; color: #232425; }
  .resume h2 { font-size: 1.5rem; font-weight: 400; margin-bottom: 0.8rem; }
  .resume h2 .accent { font-size: 1.12em; }
  .resume :global(p) { margin: 0 0 1.1rem; }
  .titre-liste .cadre { padding-block: 1.6rem 0; }
  .titre-liste h2 { font-size: 1.05rem; font-weight: 500; }
  .titre-liste { border-bottom: 0; }
</style>
