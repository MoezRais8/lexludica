---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TitrePage from '../../components/TitrePage.astro';
import { articlesPublies, formatDateCourte } from '../../lib/utils';

const decisions = (await getCollection('decisions')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const articles = await articlesPublies();
const nbCitations = (id: string) => articles.filter((a) => a.data.decisions.some((d) => d.id === id)).length;
const ordres = [...new Set(decisions.map((d) => d.data.ordre))];
---
<Base section="jurisprudence" titre="Jurisprudence" description="Les décisions de justice qui font le droit du jeu vidéo, résumées et reliées aux analyses de Lex Ludica.">
  <TitrePage surtitre="Base de données" titre="La" accent="jurisprudence" sous="Les décisions qui font le droit du jeu vidéo, résumées et reliées aux analyses qui les citent.">
    <div class="filtres" role="group" aria-label="Filtrer par ordre juridique" id="filtres" hidden>
      <button type="button" class="filtre actif" data-ordre="">Toutes <span>{decisions.length}</span></button>
      {ordres.map((o) => <button type="button" class="filtre" data-ordre={o}>{o} <span>{decisions.filter((d) => d.data.ordre === o).length}</span></button>)}
    </div>
  </TitrePage>
  <section class="bande">
    <div class="cadre bloc">
      <ul class="decisions" id="decisions">
        {decisions.map((d) => (
          <li data-ordre={d.data.ordre}>
            <a href={`/jurisprudence/${d.id}`}>
              <span class="col-date">
                <span class="annee">{d.data.date.getFullYear()}</span>
                <span class="date">{formatDateCourte(d.data.date)}</span>
              </span>
              <span class="col-corps">
                <span class="haut">
                  <span class="nom accent">{d.data.nom}</span>
                  <span class="tag sombre">{d.data.ordre}</span>
                </span>
                <span class="ref">{d.data.juridiction}, {d.data.numero}</span>
                <span class="apport">{d.data.apport}</span>
              </span>
              <span class="col-cit">{nbCitations(d.id)} <span>{nbCitations(d.id) > 1 ? 'articles' : 'article'}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  const zone = document.getElementById('filtres');
  if (zone) {
    zone.hidden = false;
    const items = document.querySelectorAll<HTMLLIElement>('#decisions li');
    zone.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      zone.querySelectorAll('button').forEach((x) => x.classList.toggle('actif', x === b));
      const o = b.dataset.ordre;
      items.forEach((li) => (li.hidden = !!o && li.dataset.ordre !== o));
    });
  }
</script>

<style>
  .filtres { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.4rem; }
  .filtre { font: inherit; font-size: 0.8rem; font-weight: 500; padding: 0.4rem 0.75rem; border: 1px solid var(--line); background: #ffffff; color: var(--ink); border-radius: 3px; cursor: pointer; }
  .filtre span { color: var(--muted); margin-left: 0.2rem; }
  .filtre.actif { background: var(--blue); border-color: var(--blue); color: #ffffff; }
  .filtre.actif span { color: rgba(255, 255, 255, 0.75); }
  .bloc { padding-block: 2.4rem 3rem; }
  .decisions { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .decisions li { border-bottom: 1px solid var(--line); }
  .decisions a { display: grid; grid-template-columns: 7rem minmax(0, 1fr) 6rem; gap: 1.5rem; padding: 1.3rem 0.4rem; color: var(--ink); text-decoration: none; align-items: start; }
  .decisions a:hover { background: var(--surface); }
  .decisions a:hover .nom { color: var(--blue); }
  .col-date { display: flex; flex-direction: column; }
  .annee { font-family: var(--serif); font-size: 2rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .col-corps { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .haut { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  .nom { font-size: 1.6rem; line-height: 1.1; }
  .ref { font-size: 0.82rem; color: var(--ink-soft); font-weight: 500; }
  .apport { font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5; max-width: 60ch; }
  .col-cit { font-family: var(--serif); font-size: 1.6rem; line-height: 1; text-align: right; }
  .col-cit span { display: block; font-family: var(--sans); font-size: 0.7rem; color: var(--muted); margin-top: 0.2rem; }
  @media (max-width: 640px) {
    .decisions a { grid-template-columns: 1fr; gap: 0.6rem; }
    .col-date { flex-direction: row; align-items: baseline; gap: 0.6rem; }
    .col-cit { text-align: left; font-size: 1rem; }
    .col-cit span { display: inline; margin-left: 0.2rem; }
  }
</style>
