<style>
  .bloc { padding-block: 2.6rem 3rem; }
  .texte { max-width: var(--lecture); }
  h2 { font-size: 1.25rem; font-weight: 500; margin: 2.2rem 0 0.6rem; scroll-margin-top: 5rem; }
  h3 { font-size: 1rem; font-weight: 600; margin: 1.4rem 0 0.4rem; }
  p { margin: 0 0 1rem; color: var(--ink-soft); line-height: 1.7; }
  .fiche { padding: 1rem 1.2rem; border-left: 3px solid var(--blue, #0055b4); background: rgba(0, 85, 180, 0.04); }
  a { color: var(--blue, #0055b4); }
</style>
