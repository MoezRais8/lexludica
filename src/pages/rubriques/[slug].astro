---
import Base from '../../layouts/Base.astro';
import TitrePage from '../../components/TitrePage.astro';
import ListeOuVide from '../../components/ListeOuVide.astro';
import { rubriques } from '../../data/rubriques';
import { articlesPublies, slugTag } from '../../lib/utils';

export function getStaticPaths() {
  return rubriques.map((r) => ({ params: { slug: r.slug }, props: { rubrique: r } }));
}
const { rubrique } = Astro.props;
const articles = (await articlesPublies()).filter((a) => a.data.rubrique === rubrique.slug);
---
<Base titre={rubrique.nom} description={rubrique.description}>
  <TitrePage surtitre="Catégorie" titre="" accent={rubrique.nom} sous={rubrique.description}>
    <div class="tags">{rubrique.tags.map((t) => <a class="tag" href={`/etiquettes/${slugTag(t)}`}>#{t}</a>)}</div>
  </TitrePage>
  <ListeOuVide articles={articles} messageVide="Les premières analyses de cette rubrique arrivent bientôt." />
</Base>

<style>
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.2rem; }
</style>
