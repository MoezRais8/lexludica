---
import Base from '../../layouts/Base.astro';
import TitrePage from '../../components/TitrePage.astro';
import { rubriques } from '../../data/rubriques';
import { articlesPublies, slugTag } from '../../lib/utils';
const articles = await articlesPublies();
const nb = (s: string) => articles.filter((a) => a.data.rubrique === s).length;
---
<Base titre="Catégories" description="Les huit rubriques de Lex Ludica.">
  <TitrePage titre="Toutes les" accent="catégories" sous="Huit portes d'entrée pour lire le jeu vidéo, du droit à la psychologie." />
  <section class="bande">
    <div class="cadre bloc">
      <div class="categories">
        {rubriques.map((r) => (
          <article class="cat">
            <div class="haut">
              <h2><a href={`/rubriques/${r.slug}`} class="accent">{r.nom}</a></h2>
              <span class="nb">{nb(r.slug)} {nb(r.slug) > 1 ? 'articles' : 'article'}</span>
            </div>
            <p>{r.description}</p>
            <div class="cat-tags">{r.tags.map((t) => <a class="tag" href={`/etiquettes/${slugTag(t)}`}>#{t}</a>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .bloc { padding-block: 2.6rem 3rem; }
  .categories { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 1rem; }
  .cat { background: var(--surface); border: 1px solid var(--line); padding: 1.4rem 1.3rem 1.2rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .haut { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  h2 { font-size: 1.85rem; line-height: 1; }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--blue); }
  .nb { font-size: 0.72rem; color: var(--muted); white-space: nowrap; }
  p { margin: 0; font-size: 0.82rem; line-height: 1.55; color: var(--muted); }
  .cat-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: auto; padding-top: 0.6rem; }
</style>
